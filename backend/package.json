{
  "name": "agents-platform-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "start": "bun src/index.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "db:generate": "bun --bun drizzle-kit generate",
    "db:migrate": "bun --bun drizzle-kit migrate",
    "db:check": "bun --bun drizzle-kit check",
    "db:studio": "bun --bun drizzle-kit studio"
  },
  "packageManager": "bun@1.4.3",
  "dependencies": {
    "@fastify/cors": "11",
    "@fastify/swagger": "9",
    "@fastify/swagger-ui": "5",
    "@fastify/type-provider-zod": "^1.0.1",
    "dotenv": "^18.0.8",
    "drizzle-orm": "0.45",
    "drizzle-zod": "0.8.3",
    "fastify": "5",
    "pg": "^8.23.1",
    "zod": "4"
  },
  "devDependencies": {
    "@types/bun": "^1.4.3",
    "@types/node": "22",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "0.31",
    "eslint": "9",
    "prettier": "^3.9.10",
    "typescript": "5",
    "typescript-eslint": "^8.72.0"
  }
}
